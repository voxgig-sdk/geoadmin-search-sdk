# Entity: search

main: kit: entity: search: {

  alias: field: {}

  fields: [
    {
      name: "results"
      req: false
      type: "`$ARRAY`"
    }
  ]

  name: "search"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                example: "551306.5625,167918.328125,551754.125,168514.625"
                kind: "query"
                name: "bbox"
                orig: "bbox"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "callback"
                orig: "callback"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "ch.bafu.hydrologie-gewaesserzustandsmessstationen"
                kind: "query"
                name: "feature"
                orig: "feature"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "geometry_format"
                orig: "geometry_format"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "de"
                kind: "query"
                name: "lang"
                orig: "lang"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 50
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: "address,gazetteer"
                kind: "query"
                name: "origin"
                orig: "origin"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: true
                kind: "query"
                name: "return_geometry"
                orig: "return_geometry"
                reqd: false
                type: "`$BOOLEAN`"
              }
              {
                example: "wabern"
                kind: "query"
                name: "search_text"
                orig: "search_text"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: true
                kind: "query"
                name: "sortbbox"
                orig: "sortbbox"
                reqd: false
                type: "`$BOOLEAN`"
              }
              {
                example: "21781"
                kind: "query"
                name: "sr"
                orig: "sr"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "locations"
                kind: "query"
                name: "type"
                orig: "type"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/rest/services/ech/SearchServer"
          parts: [
            "rest"
            "services"
            "ech"
            "SearchServer"
          ]
          select: {
            exist: [
              "bbox"
              "callback"
              "feature"
              "geometry_format"
              "lang"
              "limit"
              "origin"
              "return_geometry"
              "search_text"
              "sortbbox"
              "sr"
              "type"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
