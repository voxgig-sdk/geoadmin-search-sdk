# Entity: search

main: kit: entity: search: {

  alias: field: {}

  fields: [
    {
      name: "results"
      req: false
      type: "`$ARRAY`"
    }
  ]

  name: "search"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                example: "551306.5625,167918.328125,551754.125,168514.625"
                kind: "query"
                name: "bbox"
                orig: "bbox"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "callback"
                orig: "callback"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "ch.bafu.hydrologie-gewaesserzustandsmessstationen"
                kind: "query"
                name: "feature"
                orig: "feature"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "geometry_format"
                orig: "geometry_format"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "de"
                kind: "query"
                name: "lang"
                orig: "lang"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 50
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: "address,gazetteer"
                kind: "query"
                name: "origin"
                orig: "origin"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: true
                kind: "query"
                name: "return_geometry"
                orig: "return_geometry"
                reqd: false
                type: "`$BOOLEAN`"
              }
              {
                example: "wabern"
                kind: "query"
                name: "search_text"
                orig: "search_text"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: true
                kind: "query"
                name: "sortbbox"
                orig: "sortbbox"
                reqd: false
                type: "`$BOOLEAN`"
              }
              {
                example: "21781"
                kind: "query"
                name: "sr"
                orig: "sr"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "locations"
                kind: "query"
                name: "type"
                orig: "type"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /rest/services/ech/SearchServer"
            json: "{\"operationId\":\"searchServer\",\"parameters\":[{\"description\":\"The type of search to perform. Required parameter.\",\"example\":\"locations\",\"in\":\"query\",\"name\":\"type\",\"required\":true,\"schema\":{\"enum\":[\"locations\",\"layers\",\"featuresearch\"],\"type\":\"string\"}},{\"description\":\"The text to search for. Maximum of 10 words. Required unless bbox is provided for location search. Required for layer and feature search.\",\"example\":\"wabern\",\"in\":\"query\",\"name\":\"searchText\",\"required\":false,\"schema\":{\"maxLength\":500,\"type\":\"string\"}},{\"description\":\"A comma separated list of 4 coordinates representing the bounding box on which features should be filtered (SRID: 21781 or 2056). Format: minX,minY,maxX,maxY. Required for location search if searchText is not provided. Optional for feature search.\",\"example\":\"551306.5625,167918.328125,551754.125,168514.625\",\"in\":\"query\",\"name\":\"bbox\",\"required\":false,\"schema\":{\"pattern\":\"^[0-9.]+,[0-9.]+,[0-9.]+,[0-9.]+$\",\"type\":\"string\"}},{\"description\":\"When bbox is specified and this parameter is true, then the ranking of the results is performed according to the distance between the locations and the center of the bounding box. Applicable to location and feature search.\",\"in\":\"query\",\"name\":\"sortbbox\",\"required\":false,\"schema\":{\"default\":true,\"type\":\"boolean\"}},{\"description\":\"Defines whether the geometry is returned or not. Applicable to location search only.\",\"in\":\"query\",\"name\":\"returnGeometry\",\"required\":false,\"schema\":{\"default\":true,\"type\":\"boolean\"}},{\"description\":\"A comma separated list of origins for location search. Possible values: zipcode, gg25, district, kantone, gazetteer, address, parcel. By default all origins are used.\",\"example\":\"address,gazetteer\",\"in\":\"query\",\"name\":\"origins\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"A comma separated list of technical layer names. Required for feature search.\",\"example\":\"ch.bafu.hydrologie-gewaesserzustandsmessstationen\",\"in\":\"query\",\"name\":\"features\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"The maximum number of results to retrieve per request. Max and default: 50 for locations, 30 for layers, 20 for features.\",\"in\":\"query\",\"name\":\"limit\",\"required\":false,\"schema\":{\"default\":50,\"maximum\":50,\"minimum\":1,\"type\":\"integer\"}},{\"description\":\"The spatial reference system. Supported values: 21781 (LV03), 2056 (LV95), 4326 (WGS84), 3857 (Web Pseudo-Mercator). Note: for feature search only 21781 and 2056 are supported.\",\"in\":\"query\",\"name\":\"sr\",\"required\":false,\"schema\":{\"default\":\"21781\",\"enum\":[\"21781\",\"2056\",\"4326\",\"3857\"],\"type\":\"string\"}},{\"description\":\"The language for metadata. Applicable to layer search only.\",\"in\":\"query\",\"name\":\"lang\",\"required\":false,\"schema\":{\"default\":\"de\",\"enum\":[\"de\",\"fr\",\"it\",\"rm\",\"en\"],\"type\":\"string\"}},{\"description\":\"Set to 'geojson' if you want the service to return a GeoJSON FeatureCollection. Geometries will be returned in the sr projection.\",\"in\":\"query\",\"name\":\"geometryFormat\",\"required\":false,\"schema\":{\"enum\":[\"geojson\"],\"type\":\"string\"}},{\"description\":\"The name of the callback function for JSONP requests.\",\"in\":\"query\",\"name\":\"callback\",\"required\":false,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"addressSearch\":{\"summary\":\"Address search with links\",\"value\":{\"results\":[{\"attrs\":{\"detail\":\"landstrasse # 8595 altnau 4641 altnau ch tg\",\"featureId\":\"191979601_0\",\"geom_quadindex\":\"012323201233230311110\",\"geom_st_box2d\":\"BOX(2737666 1275668,2737666 1275668)\",\"label\":\"Landstrasse # <b>8595 Altnau</b>\",\"lat\":47.61722946166992,\"lon\":9.269905090332031,\"num\":0,\"objectclass\":\"\",\"origin\":\"address\",\"rank\":7,\"x\":1275668,\"y\":2737666,\"zoomlevel\":10},\"id\":1926520,\"links\":[{\"href\":\"/rest/services/ech/MapServer/ch.swisstopo.amtliches-gebaeudeadressverzeichnis/<featureid>\",\"rel\":\"related\",\"title\":\"ch.swisstopo.amtliches-gebaeudeadressverzeichnis\"},{\"href\":\"/rest/services/ech/MapServer/ch.bfs.gebaeude_wohnungs_register/<featureid>\",\"rel\":\"related\",\"title\":\"ch.bfs.gebaeude_wohnungs_register\"}],\"weight\":100}]}},\"featureSearch\":{\"summary\":\"Feature search results\",\"value\":{\"results\":[{\"attrs\":{\"detail\":\"4330 ob rbk, zinggen aeaecheli\",\"featureId\":\"1821\",\"feature_id\":\"1821\",\"geom_quadindex\":\"030111222231132003303\",\"geom_st_box2d\":\"BOX(765885.282632635 255374.66946989714,765885.282632635 255374.66946989714)\",\"label\":\"Ob RBK, Zinggen\",\"lat\":47.428253173828125,\"layer\":\"ch.bafu.hydrologie-gewaesserzustandsmessstationen\",\"lon\":9.637541770935059,\"origin\":\"feature\"},\"id\":4330,\"weight\":5}]}},\"geoJsonSearch\":{\"summary\":\"GeoJSON format response\",\"value\":{\"bbox\":[601112.8374564094,197515.61386168728,601112.8374564094,197515.61386168728],\"features\":[{\"bbox\":[601112.8374564094,197515.61386168728,601112.8374564094,197515.61386168728],\"geometry\":{\"coordinates\":[197515.609375,601112.8125],\"type\":\"Point\"},\"id\":357116,\"properties\":{\"detail\":\"wabern koeniz\",\"geom_quadindex\":\"021300220302121113110\",\"geom_st_box2d\":\"BOX(601112.8374564094 197515.61386168728,601112.8374564094 197515.61386168728)\",\"id\":357116,\"label\":\"<i>Populated Place</i> <b>Wabern</b> (BE) - Köniz\",\"lat\":46.928733825683594,\"lon\":7.453245639801025,\"num\":1,\"objectclass\":\"TLM_SIEDLUNGSNAME\",\"origin\":\"gazetteer\",\"rank\":5,\"weight\":100,\"x\":197515.609375,\"y\":601112.8125,\"zoomlevel\":10},\"type\":\"Feature\"}],\"type\":\"FeatureCollection\"}},\"layerSearch\":{\"summary\":\"Layer search results\",\"value\":{\"results\":[{\"attrs\":{\"detail\":\"modele de geoide chgeo2004 en ch1903\",\"label\":\"<b>Géoïde en CH1903</b>\",\"lang\":\"fr\",\"layer\":\"ch.swisstopo.geoidmodell-ch1903\",\"origin\":\"layer\",\"staging\":\"prod\",\"title\":\"geoide en ch1903\",\"topics\":\"api,ech,geodesy,geol,inspire,service-wms,swisstopo\"},\"id\":101,\"weight\":48}]}},\"locationSearch\":{\"summary\":\"Location search results\",\"value\":{\"results\":[{\"attrs\":{\"detail\":\"wabern koeniz\",\"geom_quadindex\":\"021300220302121113110\",\"geom_st_box2d\":\"BOX(601112.8374564094 197515.61386168728,601112.8374564094 197515.61386168728)\",\"label\":\"<i>Populated Place</i> <b>Wabern</b> (BE) - Köniz\",\"lat\":46.928733825683594,\"lon\":7.453245639801025,\"num\":1,\"objectclass\":\"TLM_SIEDLUNGSNAME\",\"origin\":\"gazetteer\",\"rank\":5,\"x\":197515.609375,\"y\":601112.8125,\"zoomlevel\":10},\"id\":357116,\"weight\":100}]}}},\"schema\":{\"oneOf\":[{\"properties\":{\"results\":{\"items\":{\"properties\":{\"attrs\":{\"properties\":{\"@geodist\":{\"description\":\"Geographic distance (when bbox sorting is applied)\",\"type\":\"number\"},\"detail\":{\"description\":\"The search field detail\",\"type\":\"string\"},\"featureId\":{\"description\":\"Feature ID that can be combined with layerBodId for more information\",\"type\":\"string\"},\"feature_id\":{\"description\":\"Alternative feature identifier\",\"type\":\"string\"},\"geom_quadindex\":{\"description\":\"Quadindex of the geometry\",\"type\":\"string\"},\"geom_st_box2d\":{\"description\":\"Bounding box of the associated geometry in CH1903/LV03 (EPSG:21781)\",\"type\":\"string\"},\"label\":{\"description\":\"HTML label for the entry\",\"type\":\"string\"},\"lang\":{\"description\":\"Language code (for layer results)\",\"type\":\"string\"},\"lat\":{\"description\":\"Latitude coordinate\",\"type\":\"number\"},\"layer\":{\"description\":\"Layer identifier (for layer and feature results)\",\"type\":\"string\"},\"layerBodId\":{\"description\":\"The ID of the associated layer (if any)\",\"type\":\"string\"},\"lon\":{\"description\":\"Longitude coordinate\",\"type\":\"number\"},\"num\":{\"description\":\"Street number (for address origin)\",\"type\":\"integer\"},\"objectclass\":{\"description\":\"Object class identifier\",\"type\":\"string\"},\"origin\":{\"description\":\"The type of data (zipcode, gg25, district, kantone, gazetteer, address, parcel, layer, feature)\",\"enum\":[\"zipcode\",\"gg25\",\"district\",\"kantone\",\"gazetteer\",\"address\",\"parcel\",\"layer\",\"feature\"],\"type\":\"string\"},\"rank\":{\"description\":\"Rank associated with the origin. Results ordered in ascending rank\",\"type\":\"integer\"},\"staging\":{\"description\":\"Staging environment (for layer results)\",\"type\":\"string\"},\"title\":{\"description\":\"Title (for layer results)\",\"type\":\"string\"},\"topics\":{\"description\":\"Related topics (for layer results)\",\"type\":\"string\"},\"x\":{\"description\":\"X coordinate on the geometry\",\"type\":\"number\"},\"y\":{\"description\":\"Y coordinate on the geometry\",\"type\":\"number\"},\"zoomlevel\":{\"description\":\"Suggested zoom level\",\"type\":\"integer\"}},\"type\":\"object\"},\"id\":{\"description\":\"Internal identifier (should not be used externally)\",\"type\":\"integer\"},\"links\":{\"description\":\"Array of related resources (for address results)\",\"items\":{\"properties\":{\"href\":{\"description\":\"URL path to access the related feature resource\",\"example\":\"/rest/services/ech/MapServer/ch.swisstopo.amtliches-gebaeudeadressverzeichnis/<featureid>\",\"type\":\"string\"},\"rel\":{\"description\":\"Relationship type\",\"example\":\"related\",\"type\":\"string\"},\"title\":{\"description\":\"Layer ID of the related resource\",\"example\":\"ch.swisstopo.amtliches-gebaeudeadressverzeichnis\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"weight\":{\"description\":\"Similarity weight between search query and index. For locations: 100 indicates exact match, <100 partial/wildcard, >1000 fuzzy results\",\"type\":\"number\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"},{\"properties\":{\"bbox\":{\"description\":\"Bounding box [minX, minY, maxX, maxY]\",\"items\":{\"type\":\"number\"},\"maxItems\":4,\"minItems\":4,\"type\":\"array\"},\"features\":{\"items\":{\"properties\":{\"bbox\":{\"items\":{\"type\":\"number\"},\"maxItems\":4,\"minItems\":4,\"type\":\"array\"},\"geometry\":{\"properties\":{\"coordinates\":{\"description\":\"Coordinates in the specified spatial reference system\"},\"type\":{\"enum\":[\"Point\",\"LineString\",\"Polygon\",\"MultiPoint\",\"MultiLineString\",\"MultiPolygon\"],\"type\":\"string\"}},\"type\":\"object\"},\"id\":{\"type\":\"integer\"},\"properties\":{\"additionalProperties\":true,\"description\":\"Feature properties including all attributes from search result\",\"type\":\"object\"},\"type\":{\"enum\":[\"Feature\"],\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"type\":{\"enum\":[\"FeatureCollection\"],\"type\":\"string\"}},\"type\":\"object\"}]}}},\"description\":\"Successful search response\"},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"code\":{\"description\":\"Error code\",\"type\":\"integer\"},\"error\":{\"description\":\"Error message\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Bad request - invalid parameters\"},\"500\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"code\":{\"description\":\"Error code\",\"type\":\"integer\"},\"error\":{\"description\":\"Error message\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Internal server error\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/rest/services/ech/SearchServer"
          segments: [
            {
              lit: "rest"
            }
            {
              lit: "services"
            }
            {
              lit: "ech"
            }
            {
              lit: "SearchServer"
            }
          ]
          select: {
            exist: [
              "bbox"
              "callback"
              "feature"
              "geometry_format"
              "lang"
              "limit"
              "origin"
              "return_geometry"
              "search_text"
              "sortbbox"
              "sr"
              "type"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
